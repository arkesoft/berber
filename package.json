{
  "name": "salon-reservation-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "dev": "react-router dev --host 127.0.0.1",
    "dev:backend": "react-router dev --mode backend --host 127.0.0.1 --port 5174",
    "build": "react-router build",
    "build:demo": "react-router build --mode demo",
    "preview": "node scripts/preview.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts": "tsx scripts/contracts.ts",
    "contracts:check": "tsx scripts/contracts.ts --check",
    "architecture": "depcruise app --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm run lint && npm run contracts:check && npm run architecture && npm test",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.0",
    "@hookform/resolvers": "^5.2.0",
    "@react-router/node": "7.18.4",
    "@tanstack/react-query": "^5.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.65.0",
    "react-router": "7.18.4",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@react-router/dev": "7.18.4",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dependency-cruiser": "^17.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "msw": "^2.12.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
