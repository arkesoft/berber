# Copy outside version control or inject through your server's secret manager.
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
DATABASE_URL=postgres://salon_app:CHANGE_ME@postgres:5432/salon
SALON_ID=your-salon-id
PUBLIC_ORIGIN=https://your-domain.example
# Generate separately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
GUEST_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
# Set only to the known reverse-proxy IP/CIDR. Never use an unbounded true value.
TRUST_PROXY=127.0.0.1
HOLD_MINUTES=10
SMS_MODE=disabled
# SMS_MODE=gateway requires the documented gateway contract; credentials alone do not implement a vendor-specific API.
# SMS_GATEWAY_URL=https://your-sms-gateway.example/messages
# SMS_GATEWAY_TOKEN=
EMAIL_MODE=disabled
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=booking@your-domain.example
# Initial setup only; unset after setup. Never commit a filled file.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
