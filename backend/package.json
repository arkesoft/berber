{
  "name": "salon-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/backend/src/server.js",
    "worker": "node --enable-source-maps dist/backend/src/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "setup": "tsx scripts/setup.ts",
    "staff-account": "tsx scripts/staff-account.ts",
    "architecture": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/session": "11.1.5",
    "@js-temporal/polyfill": "0.5.1",
    "fastify": "5.12.7",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
